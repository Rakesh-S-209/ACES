# .env.example -- Project A.C.E.S. environment variable template
# ---------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control (.gitignore already covers it).
#
# The backend reads this file automatically at startup via python-dotenv.
# Real OS environment variables always take precedence over .env values.
#
# AbuseIPDB integration
# ---------------------
# Obtain a free API key at https://www.abuseipdb.com/account/api
# Leave as the placeholder (or remove the line) to run in OFFLINE_MOCK mode.
# In OFFLINE_MOCK mode no outbound reports are sent and no quota is consumed.
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Application environment: development | production
# Controls CORS policy, debug logging, and TLS requirements.
ACES_ENV=development

# SOAR Monitor-Only mode: set to 1 to log and stream all threat events to the
# SOC dashboard WITHOUT blocking or banning the attacker's HTTP session.
# Ideal for live Kali VM demonstrations so you can observe full attack behaviour
# (Gobuster, Nmap, honeytoken trips) without the 403 lockout cutting the feed.
# Set to 0 (or remove) to restore full hard-containment enforcement.
ACES_MONITOR_ONLY=0

# ---------------------------------------------------------------------------
# Configurable Honeyport List
# ---------------------------------------------------------------------------
# Comma-separated list of TCP ports the PortTrap daemon will bind at startup.
# Any inbound TCP connection on one of these ports triggers an immediate
# PORT_TRAP AlertEvent and adds the source IP to the quarantine blacklist.
#
# Common decoy choices:
#   3389  -- Remote Desktop / RDP (most scanned Windows port)
#   22    -- SSH decoy
#   21    -- FTP decoy
#   445   -- SMB / Windows File Sharing decoy
#   8080  -- Alternate HTTP proxy decoy
#   23    -- Telnet decoy
#
# Note: ports < 1024 require administrator / root privileges on most OSes.
# On Windows, port 445 is reserved by the OS and will fail to bind unless
# the Server service (LanmanServer) is stopped first.
#
# Default (matches the original hard-coded set):
ACES_HONEYPORT_LIST=3389,22,445
